#!/usr/bin/env bash
# team/peek <file>
# Fetches one raw workbook (toi16.xlsx, say) with the audit key that staff hand out at the checkpoint, and
# saves it as team/peeked/<file> to open in Excel. Run from a plain terminal that is not a Claude Code
# session: the file contains names. The fetch is logged.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/config"
if [ ! -f "$cfg" ]; then echo "$(basename "$0"): no team/config; copy the three lines from the team's card" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
server="${server%/}"
auth=(-H "X-Group: $group" -H "X-Team-Token: $token")
if [ $# -ne 1 ]; then echo "usage: team/peek <file>    e.g. team/peek toi16.xlsx" >&2; exit 2; fi
printf 'audit key (from staff, at the checkpoint): '
read -r akey
mkdir -p "$here/peeked"
out="$here/peeked/$1"
code="$(curl -sS --max-time 60 "${auth[@]}" -H "X-Audit-Key: $akey" -o "$out" -w '%{http_code}' "$server/raw/$1")"
if [ "$code" != "200" ]; then echo "peek: refused (HTTP $code): $(cat "$out")"; rm -f "$out"; exit 1; fi
echo "saved $out ($(wc -c < "$out" | tr -d ' ') bytes). Open it in Excel. It contains names: keep it out of every Claude Code session."
