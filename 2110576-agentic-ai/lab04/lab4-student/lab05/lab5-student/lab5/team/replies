#!/usr/bin/env bash
# team/replies [--follow] [<run id>]
# Prints the reply log: every reply the tool has sent back, newest last, each under a header line with the
# run id, time, exit code and the call. --follow keeps printing new replies as they arrive (Skeptic's
# live view; stop with Ctrl-C). Reading the log is itself logged as a crossing.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/config"
if [ ! -f "$cfg" ]; then echo "$(basename "$0"): no team/config; copy the three lines from the team's card" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
server="${server%/}"
auth=(-H "X-Group: $group" -H "X-Team-Token: $token")
follow=0; since=0
for a in "$@"; do case "$a" in --follow|-f) follow=1;; *) since=$((a-1));; esac; done
while :; do
  out="$(curl -sS --max-time 30 "${auth[@]}" "$server/teams/$group/replies?since=$since")" || exit 3
  if [ "$out" != "(no replies yet)" ] && [ -n "$out" ]; then printf '%s\n' "$out"; fi
  last="$(printf '%s\n' "$out" | grep -E '^=== run [0-9]+ ' | tail -n 1 | awk '{print $3}')"
  if [ -n "$last" ]; then since="$last"; fi
  if [ $follow -eq 0 ]; then break; fi
  sleep 3
done
