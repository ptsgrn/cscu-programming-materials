#!/usr/bin/env bash
# team/errors <run id>
# Prints what tool.py wrote to standard error in one run (a traceback, the model-call lines). The run id is
# in the ./wall error message and in the reply log. Operator's command. The fetch is logged as a crossing.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/config"
if [ ! -f "$cfg" ]; then echo "$(basename "$0"): no team/config; copy the three lines from the team's card" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
server="${server%/}"
auth=(-H "X-Group: $group" -H "X-Team-Token: $token")
if [ $# -ne 1 ]; then echo "usage: team/errors <run id>" >&2; exit 2; fi
curl -sS --max-time 30 "${auth[@]}" "$server/teams/$group/runs/$1/stderr"
