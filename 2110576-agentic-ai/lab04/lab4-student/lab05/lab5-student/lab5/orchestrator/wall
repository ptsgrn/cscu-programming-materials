#!/usr/bin/env bash
# ./wall <command> [arguments]
# The shim. Sends the arguments to the server, which runs the team's tool.py with them, and prints what
# the tool printed. Reads the server address, group id and token from ../team/config. Do not edit.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/../team/config"
if [ ! -f "$cfg" ]; then echo "wall: no team/config beside orchestrator/; copy the three lines from the team's card" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
if [ -z "$server" ] || [ -z "$group" ] || [ -z "$token" ]; then echo "wall: team/config needs three lines: server, group id, token" >&2; exit 2; fi
if [ $# -lt 1 ]; then echo "usage: ./wall <command> [arguments]   (TOOLS.md lists the commands)" >&2; exit 2; fi
tmp="$(mktemp)"; hdr="$(mktemp)"; trap 'rm -f "$tmp" "$hdr"' EXIT
printf '%s\n' "$@" | curl -sS --max-time 150 -X POST --data-binary @- \
  -H 'Content-Type: text/plain; charset=utf-8' -H "X-Group: $group" -H "X-Team-Token: $token" \
  -D "$hdr" -o "$tmp" "${server%/}/run"
rc=$?
if [ $rc -ne 0 ]; then echo "wall: could not reach the server at $server (curl exit $rc)" >&2; exit 3; fi
status="$(head -n 1 "$hdr" | tr -d '\r' | awk '{print $2}')"
cat "$tmp"
if [ "$status" != "200" ]; then echo "wall: the server refused the call (HTTP $status)" >&2; exit 4; fi
run="$(grep -i '^x-run-id:' "$hdr" | tr -d '\r' | awk '{print $2}')"
code="$(grep -i '^x-exit-code:' "$hdr" | tr -d '\r' | awk '{print $2}')"
timeout="$(grep -i '^x-timeout:' "$hdr" | tr -d '\r' | awk '{print $2}')"
if [ "${timeout:-0}" = "1" ]; then echo "wall: tool.py ran out of time (two minutes) in run $run; the reply above is what it had printed" >&2; exit 1; fi
if [ "${code:-0}" != "0" ]; then echo "wall: tool.py exited with code $code in run $run; the Operator can read the error with: team/errors $run" >&2; exit 1; fi
exit 0
