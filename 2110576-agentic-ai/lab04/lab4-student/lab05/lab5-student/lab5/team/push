#!/usr/bin/env bash
# team/push
# Uploads tool/tool.py, tool/inside.py and tool/leak-patterns.txt to the server. Every version is kept
# there. Run from a plain terminal, not inside a Claude Code session. Operator's command.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/config"
if [ ! -f "$cfg" ]; then echo "$(basename "$0"): no team/config; copy the three lines from the team's card" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
server="${server%/}"
auth=(-H "X-Group: $group" -H "X-Team-Token: $token")
tooldir="$here/../tool"
for f in tool.py inside.py leak-patterns.txt; do
  if [ ! -f "$tooldir/$f" ]; then echo "push: $tooldir/$f is missing" >&2; continue; fi
  curl -sS --max-time 30 "${auth[@]}" -X PUT --data-binary @"$tooldir/$f" -H 'Content-Type: text/plain; charset=utf-8' "$server/teams/$group/files/$f"
done
