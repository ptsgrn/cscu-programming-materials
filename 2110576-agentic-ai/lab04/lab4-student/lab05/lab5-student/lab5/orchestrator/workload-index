#!/usr/bin/env bash
# ./workload-index
# The second shim. Prints the twelve file names on the server, one per line. Do not edit.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cfg="$here/../team/config"
if [ ! -f "$cfg" ]; then echo "workload-index: no team/config beside orchestrator/" >&2; exit 2; fi
i=0; server=""; group=""; token=""
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in ''|'#'*) continue;; esac
  i=$((i+1))
  case $i in 1) server="$line";; 2) group="$line";; 3) token="$line";; esac
done < "$cfg"
curl -sS --max-time 20 -H "X-Group: $group" -H "X-Team-Token: $token" "${server%/}/index"
